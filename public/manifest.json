{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "version": "1.0.357",
  "description": "__MSG_extDescription__",
  "default_locale": "en",
  "permissions": [
    "sidePanel",
    "bookmarks",
    "tabs",
    "tabGroups",
    "webNavigation",
    "storage",
    "favicon"
  ],
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "128": "icon.png"
  },
  "action": {
    "default_title": "__MSG_actionTitle__",
    "default_icon": {
      "16": "icon16.png",
      "32": "icon32.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "index.html"
  },
  "commands": {
    "_execute_side_panel": {
      "suggested_key": {
        "default": "Ctrl+Shift+E",
        "mac": "Command+Shift+E"
      },
      "description": "__MSG_cmdToggleSidePanel__"
    },
    "prev-used-tab": {
      "suggested_key": {
        "default": "Ctrl+Shift+Comma",
        "mac": "Command+Shift+Comma"
      },
      "description": "__MSG_cmdPrevUsedTab__"
    },
    "next-used-tab": {
      "suggested_key": {
        "default": "Ctrl+Shift+Period",
        "mac": "Command+Shift+Period"
      },
      "description": "__MSG_cmdNextUsedTab__"
    },
    "open-space-navigator": {
      "suggested_key": {
        "default": "Ctrl+Shift+S",
        "mac": "Command+Shift+S"
      },
      "description": "__MSG_cmdOpenSpaceNavigator__"
    }
  }
}
